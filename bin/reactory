#!/usr/bin/env bash

#
# Reactory CLI Executable
# This script provides a unified command-line interface for Reactory operations
#

# Default values
CONFIG_NAME="${REACTORY_CONFIG_NAME:-reactory}"
CONFIG_ENV="${REACTORY_CONFIG_ENV:-local}"
DEBUG_MODE=false
WATCH_MODE=false
VERBOSE=false

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

# Source shell utilities
if [ -f "${SCRIPT_DIR}/shared/shell-utils.sh" ]; then
  source "${SCRIPT_DIR}/shared/shell-utils.sh"
fi

# Parse command line arguments
COMMAND=""
# An ARRAY, not a string. A string expanded unquoted is word-split on spaces, so
# `--input='{"id": 1}'` reached the CLI as two broken fragments and failed with
# "Unexpected end of JSON input". An array preserves each argument verbatim.
KWARGS=()

show_help() {
  cat << EOF
Reactory CLI - Unified command-line interface for Reactory

Usage: reactory <command> [options]

Commands:
  service-gen             Generate TypeScript services from YAML definitions
  module-gen              Generate a new Reactory module structure
  workflow                Execute workflow-related commands
  help                    Show this help message
  list [module]           List available commands for a module
  modules                 List all available modules

Options:
  --cname=<name>          Configuration name (default: reactory)
  --cenv=<env>            Configuration environment (default: local)
  --debug                 Enable debug mode
  --watch                 Enable watch mode
  --verbose, -v           Enable verbose logging (silent by default)
  -h, --help              Show help message

Environment Variables:
  REACTORY_CONFIG_NAME    Default configuration name
  REACTORY_CONFIG_ENV     Default configuration environment

Examples:
  # Generate service from YAML
  reactory service-gen -c ./service.yaml -o ./generated

  # List all available commands
  reactory list

  # List commands for a specific module
  reactory list reactory-core

  # Generate a new module
  reactory module-gen --name MyModule --namespace myapp

EOF
}

map_command() {
  case $1 in
    service-gen) echo "ServiceGen" ;;
    module-gen) echo "ModuleGen" ;;
    schema-gen) echo "SchemaGen" ;;
    csv2json) echo "Csv2Json" ;;
    init-system) echo "InitializeSystemUser" ;;
    *) echo "$1" ;;
  esac
}

# Parse arguments
SHOW_REACTORY_HELP=false
while [[ $# -gt 0 ]]; do
  case $1 in
    help)
      # If help is a command by itself
      if [ -z "$COMMAND" ]; then
        SHOW_REACTORY_HELP=true
      fi
      shift
      ;;
    --cname=*)
      CONFIG_NAME="${1#*=}"
      shift
      ;;
    --cenv=*)
      CONFIG_ENV="${1#*=}"
      shift
      ;;
    --debug)
      DEBUG_MODE=true
      shift
      ;;
    --bun)
      USE_BUN=true
      shift
      ;;
    --bun-version=*)
      USE_BUN=true
      BUN_VERSION="${1#*=}"
      shift
      ;;
    --version=*)
      BUN_VERSION="${1#*=}"
      shift
      ;;
    --watch)
      WATCH_MODE=true
      shift
      ;;
    --verbose|-v)
      VERBOSE=true
      shift
      ;;
    --silent)
      # explicit silent mode - already default but allow override
      VERBOSE=false
      shift
      ;;
    *)
      # If we haven't captured a command yet, this is it
      if [ -z "$COMMAND" ]; then
        RAW_COMMAND="$1"
        COMMAND=$(map_command "$1")
        shift
      else
        # Everything else goes to KWARGS
        KWARGS+=("$1")
        shift
      fi
      ;;
  esac
done

# Show help if requested and no command specified
if [ "$SHOW_REACTORY_HELP" = true ] || { [ -z "$COMMAND" ] && [ ${#KWARGS[@]} -eq 0 ]; }; then
  show_help
  exit 0
fi

# Resolve environment files (base .env and optional override .env.$CONFIG_ENV)
CONFIG_BASE_ENV=""
[ -f "$PROJECT_ROOT/config/$CONFIG_NAME/.env" ] && CONFIG_BASE_ENV="$PROJECT_ROOT/config/$CONFIG_NAME/.env"

CONFIG_OVERRIDE_ENV=""
if [ -n "$CONFIG_ENV" ]; then
  if [ -f "$PROJECT_ROOT/config/$CONFIG_NAME/.env.$CONFIG_ENV" ]; then
    CONFIG_OVERRIDE_ENV="$PROJECT_ROOT/config/$CONFIG_NAME/.env.$CONFIG_ENV"
  elif [ -f "$PROJECT_ROOT/.env.$CONFIG_ENV" ]; then
    CONFIG_OVERRIDE_ENV="$PROJECT_ROOT/.env.$CONFIG_ENV"
  fi
fi

ROOT_ENV=""
[ -f "$PROJECT_ROOT/.env" ] && ROOT_ENV="$PROJECT_ROOT/.env"

TARGET_DOTENV="$PROJECT_ROOT/.env"

if [ -n "$CONFIG_BASE_ENV" ] && [ -n "$CONFIG_OVERRIDE_ENV" ]; then
  # Clean merge without duplicate keys: override keys replace base keys
  awk -F '=' '
    NR==FNR {
      line=$0; sub(/^[ \t]+/, "", line)
      if (line !~ /^#/ && line ~ /=/) {
        split(line, p, "="); k=p[1]; sub(/[ \t]+$/, "", k); o[k]=substr(line, length(k)+2); s[k]=0
      }
      next
    }
    {
      line=$0; t=line; sub(/^[ \t]+/, "", t)
      if (t !~ /^#/ && t ~ /=/) {
        split(t, p, "="); k=p[1]; sub(/[ \t]+$/, "", k)
        if (k in o) { print k "=" o[k]; s[k]=1; next }
      }
      print $0
    }
    END {
      has_new=0
      for (k in o) {
        if (s[k] == 0) {
          if (has_new == 0) { print "\n# ── Additional Overrides ──"; has_new=1 }
          print k "=" o[k]
        }
      }
    }
  ' "$CONFIG_OVERRIDE_ENV" "$CONFIG_BASE_ENV" > "${TARGET_DOTENV}.tmp"
  mv "${TARGET_DOTENV}.tmp" "$TARGET_DOTENV"
  ENV_FILE="$TARGET_DOTENV"
elif [ -n "$CONFIG_OVERRIDE_ENV" ]; then
  if [ "$CONFIG_OVERRIDE_ENV" != "$TARGET_DOTENV" ]; then
    cp "$CONFIG_OVERRIDE_ENV" "$TARGET_DOTENV"
  fi
  ENV_FILE="$TARGET_DOTENV"
elif [ -n "$CONFIG_BASE_ENV" ]; then
  if [ "$CONFIG_BASE_ENV" != "$TARGET_DOTENV" ]; then
    cp "$CONFIG_BASE_ENV" "$TARGET_DOTENV"
  fi
  ENV_FILE="$TARGET_DOTENV"
elif [ -n "$ROOT_ENV" ]; then
  ENV_FILE="$ROOT_ENV"
else
  echo "Error: Environment file not found."
  echo "Checked for base: $PROJECT_ROOT/config/$CONFIG_NAME/.env, $PROJECT_ROOT/.env"
  echo "Checked for override: $PROJECT_ROOT/config/$CONFIG_NAME/.env.$CONFIG_ENV, $PROJECT_ROOT/.env.$CONFIG_ENV"
  echo "Please ensure the configuration exists or set REACTORY_CONFIG_NAME and REACTORY_CONFIG_ENV"
  exit 1
fi

# Verify that node_modules exist
if [ ! -d "$PROJECT_ROOT/node_modules" ]; then
  echo "Error: node_modules directory not found in $PROJECT_ROOT"
  echo "Please run 'yarn install' or 'npm install' first"
  exit 1
fi

# Determine the CLI script path
CLI_SCRIPT="$PROJECT_ROOT/src/reactory/cli/index.ts"

if [ ! -f "$CLI_SCRIPT" ]; then
  echo "Error: CLI script not found: $CLI_SCRIPT"
  exit 1
fi

# Build Node options
NODE_OPTIONS="--max_old_space_size=2000000"
if [ "$DEBUG_MODE" = true ]; then
  NODE_OPTIONS="$NODE_OPTIONS --inspect"
fi

# Prepare the command
if [ "$VERBOSE" = true ]; then
  echo "Configuration: $CONFIG_NAME"
  echo "Environment: $CONFIG_ENV"
  echo "ENV File: $ENV_FILE"
  echo "Command: $COMMAND"
  echo "Arguments: ${KWARGS[*]}"
  echo "Project Root: $PROJECT_ROOT"
fi

# Pass --silent to Node if not in verbose mode so core logger can be suppressed.
# The command goes FIRST: prepending --silent ahead of it used to leave the CLI
# resolving the command from a flag token, which made every invocation a silent
# no-op (boot, "Goodbye.", exit 0). cli.ts now scans past leading flags too, but
# ordering the command first keeps the intent explicit.
CLI_ARGS=("$COMMAND" "${KWARGS[@]}")
if [ "$VERBOSE" != true ]; then
  CLI_ARGS+=("--silent")
fi

# Execute the CLI
cd "$PROJECT_ROOT" || exit 1

if [ "$USE_BUN" = true ]; then
  ensure_bun "$BUN_VERSION" || exit 1
  if [ "$WATCH_MODE" = true ]; then
    NODE_PATH=./src env-cmd --no-override -f "$ENV_FILE" -- bun --watch "$CLI_SCRIPT" $NODE_OPTIONS -- "${CLI_ARGS[@]}"
  else
    NODE_PATH=./src env-cmd --no-override -f "$ENV_FILE" -- bun run "$CLI_SCRIPT" $NODE_OPTIONS -- "${CLI_ARGS[@]}"
  fi
elif [ "$WATCH_MODE" = true ]; then
  NODE_PATH=./src env-cmd --no-override -f "$ENV_FILE" -- npx nodemon \
    -e js,ts,tsx,graphql \
    --exec npx babel-node "$CLI_SCRIPT" \
    --presets @babel/env \
    --extensions ".js,.ts" \
    $NODE_OPTIONS \
    -- "${CLI_ARGS[@]}"
else
  NODE_PATH=./src env-cmd --no-override -f "$ENV_FILE" -- npx babel-node "$CLI_SCRIPT" \
    --presets @babel/env \
    --extensions ".js,.ts" \
    $NODE_OPTIONS \
    -- "${CLI_ARGS[@]}"
fi

# Capture exit code
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
  if [ "$VERBOSE" = true ]; then
    echo "Command completed successfully"
  fi
  exit 0
else
  echo "Error: Command failed with exit code $EXIT_CODE"
  exit $EXIT_CODE
fi
